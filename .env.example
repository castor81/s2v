# Másold .env.local néven (helyi fejlesztés) / állítsd be a Vercel Environment Variables alatt.
# SOHA ne kerüljön a kliensbe vagy a repóba valódi érték.

# Supabase (csak a háttér-API használja)
SUPABASE_URL=https://<projekt>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Az "egyszerű kapu": ezzel a kóddal lehet új szavazást létrehozni
CREATE_GATE_CODE=

# Az eszközazonosító hash-eléséhez használt só (hosszú véletlen szöveg)
DEVICE_SALT=

# A QR-ba kerülő alapcím
BASE_URL=https://s2v.vercel.app

# IP-alapú sebességkorlát (kérés/perc/IP). Rendezvényen sok szavazó lehet
# ugyanazon a wifi-IP mögött, ezért az alapérték szándékosan magas.
RATE_LIMIT_PER_MIN=600
